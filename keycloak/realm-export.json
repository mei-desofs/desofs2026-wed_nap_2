{
  "realm": "arcadehaven",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,

  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyInitialCounter": 0,
  "otpPolicyDigits": 6,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyPeriod": 30,
  "otpPolicyCodeReusable": false,
  "otpSupportedApplications": ["totpAppFreeOTPName", "totpAppGoogleName"],

  "browserFlow": "browser",
  "directGrantFlow": "arcadehaven-direct-grant",

  "accessCodeLifespan": 60,
  "accessCodeLifespanLogin": 1800,
  "accessCodeLifespanUserAction": 300,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 604800,
  "offlineSessionMaxLifespanEnabled": false,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,

  "roles": {
    "realm": [
      { "name": "ADMIN",     "composite": false, "clientRole": false },
      { "name": "PUBLISHER", "composite": false, "clientRole": false },
      { "name": "BUYER",     "composite": false, "clientRole": false }
    ]
  },

  "clients": [
    {
      "clientId": "arcadehaven-public",
      "name": "ArcadeHaven Public Client",
      "description": "Public OIDC client used by browser clients and the API Direct Grant flow (grant_type=password). Direct Access Grants are retained for the current API login architecture (see V10.4.4 note in MISSING_REQUIREMENTS.md).",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:5173"
      ],
      "defaultClientScopes": ["openid", "web-origins", "acr", "profile", "roles", "email", "basic"],
      "optionalClientScopes": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000 http://localhost:5173"
      },
      "protocolMappers": [
        {
          "name": "arcadehaven-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "arcadehaven-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "arcadehaven-backend",
      "name": "ArcadeHaven Backend Service",
      "description": "Confidential service-account client used by Spring Boot for Keycloak Admin API operations (user creation, role assignment, session revocation). Authenticates via client_credentials — no user interaction (ASVS V10.4.10).",
      "enabled": true,
      "publicClient": false,
      "secret": "backend-secret-dev-CHANGE-IN-PRODUCTION",
      "clientAuthenticatorType": "client-secret",
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "consentRequired": false
    }
  ],

  "authenticationFlows": [
    {
      "alias": "browser",
      "description": "Browser based authentication with conditional TOTP for ADMIN role (ASVS V6.3.3)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "requirement": "ALTERNATIVE",
          "priority": 25,
          "userSetupAllowed": false
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "flowAlias": "browser forms",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser forms",
      "description": "Username, password, and conditional TOTP forms",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "flowAlias": "Browser - Conditional OTP",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "arcadehaven-direct-grant",
      "description": "Direct Access Grant sem OTP — MFA enforced only at browser flow (ASVS V6.3.3)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "direct-grant-validate-username",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "direct-grant-validate-password",
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "Browser - Conditional OTP",
      "description": "Requires TOTP only for users with the ADMIN realm role (ASVS V6.3.3)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorConfig": "admin-role-condition"
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    }
  ],

  "authenticatorConfig": [
    {
      "alias": "admin-role-condition",
      "config": {
        "condUserCurrentRole": "ADMIN"
      }
    }
  ],

  "users": [
    {
      "username": "admin",
      "email": "admin@arcadehaven.com",
      "firstName": "Admin",
      "lastName": "Administrator",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Admin123!",
          "temporary": false
        }
      ],
      "realmRoles": ["ADMIN"]
    },
    {
      "username": "publisher1",
      "email": "publisher1@arcadehaven.com",
      "firstName": "Publisher",
      "lastName": "One",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Xtr4Safe#2026XY",
          "temporary": false
        }
      ],
      "realmRoles": ["PUBLISHER"]
    },
    {
      "username": "buyer1",
      "email": "buyer1@arcadehaven.com",
      "firstName": "Buyer",
      "lastName": "One",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Xtr4Safe#2026XY",
          "temporary": false
        }
      ],
      "realmRoles": ["BUYER"]
    },
    {
      "username": "service-account-arcadehaven-backend",
      "enabled": true,
      "totp": false,
      "emailVerified": false,
      "serviceAccountClientId": "arcadehaven-backend",
      "credentials": [],
      "disableableCredentialTypes": [],
      "requiredActions": [],
      "realmRoles": ["default-roles-arcadehaven"],
      "clientRoles": {
        "realm-management": ["realm-admin"]
      },
      "notBefore": 0,
      "groups": []
    }
  ]
}
