        {
          "name": "Upload Game File (IMAGE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file",     "type": "file", "src": "" },
                { "key": "fileType", "type": "text", "value": "IMAGE" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/publisher/games/{{gameId}}/files", "host": ["{{baseUrl}}"], "path": ["api","publisher","games","{{gameId}}","files"] }
          }
        },
        {
          "name": "Download Game File",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Content-Disposition header present', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Disposition')).to.include('attachment');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/publisher/games/{{gameId}}/files?path=images/cover.png",
              "host": ["{{baseUrl}}"],
              "path": ["api","publisher","games","{{gameId}}","files"],
              "query": [{ "key": "path", "value": "images/cover.png" }]
            }
          }
        }
      ]
