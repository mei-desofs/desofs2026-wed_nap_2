{
  "info": {
    "name": "ArcadeHaven API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl",      "value": "http://localhost:8080",  "type": "string" },
    { "key": "keycloakUrl", "value": "http://localhost:8180",  "type": "string" },
    { "key": "realm",        "value": "arcadehaven",            "type": "string" },
    { "key": "token",        "value": "",                       "type": "string" },
    { "key": "gameId",       "value": "",                       "type": "string" },
    { "key": "orderId",      "value": "",                       "type": "string" },
    { "key": "userId",       "value": "",                       "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register – Buyer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns username and role', () => {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.username).to.eql('buyer1');",
                  "  pm.expect(json.role).to.eql('BUYER');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"buyer1\",\n  \"email\": \"buyer1@arcadehaven.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"BUYER\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] }
          }
        },
        {
          "name": "Register – Publisher",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns username and role', () => {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.username).to.eql('publisher1');",
                  "  pm.expect(json.role).to.eql('PUBLISHER');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"publisher1\",\n  \"email\": \"publisher1@arcadehaven.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"PUBLISHER\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] }
          }
        },
        {
          "name": "Register – Admin (Expects 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('ADMIN registration is forbidden', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin1\",\n  \"email\": \"admin1@arcadehaven.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] }
          }
        },
        {
          "name": "Login – Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "pm.test('Returns access_token', () => pm.expect(json.access_token).to.be.a('string'));",
                  "if (json.access_token) { pm.collectionVariables.set('token', json.access_token); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "client_id",  "value": "arcadehaven-public", "type": "text" },
                { "key": "grant_type", "value": "password",           "type": "text" },
                { "key": "username",   "value": "admin",              "type": "text" },
                { "key": "password",   "value": "Admin123!",          "type": "text" }
              ]
            },
            "url": {
              "raw": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token",
              "host": ["{{keycloakUrl}}"],
              "path": ["realms","{{realm}}","protocol","openid-connect","token"]
            }
          }
        },
        {
          "name": "Login – Buyer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "pm.test('Returns access_token', () => pm.expect(json.access_token).to.be.a('string'));",
                  "if (json.access_token) { pm.collectionVariables.set('token', json.access_token); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "client_id",  "value": "arcadehaven-public", "type": "text" },
                { "key": "grant_type", "value": "password",           "type": "text" },
                { "key": "username",   "value": "buyer1",             "type": "text" },
                { "key": "password",   "value": "Password123!",       "type": "text" }
              ]
            },
            "url": {
              "raw": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token",
              "host": ["{{keycloakUrl}}"],
              "path": ["realms","{{realm}}","protocol","openid-connect","token"]
            }
          }
        },
        {
          "name": "Login – Publisher",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "pm.test('Returns access_token', () => pm.expect(json.access_token).to.be.a('string'));",
                  "if (json.access_token) { pm.collectionVariables.set('token', json.access_token); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "client_id",  "value": "arcadehaven-public", "type": "text" },
                { "key": "grant_type", "value": "password",           "type": "text" },
                { "key": "username",   "value": "publisher1",         "type": "text" },
                { "key": "password",   "value": "Password123!",       "type": "text" }
              ]
            },
            "url": {
              "raw": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token",
              "host": ["{{keycloakUrl}}"],
              "path": ["realms","{{realm}}","protocol","openid-connect","token"]
            }
          }
        }
      ]
    },
    {
      "name": "Games (Public)",
      "item": [
        {
          "name": "Get All Active Games",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/games", "host": ["{{baseUrl}}"], "path": ["api","games"] }
          }
        },
        {
          "name": "Get Game by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has id field', () => pm.expect(pm.response.json().id).to.exist);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/games/{{gameId}}", "host": ["{{baseUrl}}"], "path": ["api","games","{{gameId}}"] }
          }
        }
      ]
    },
    {
      "name": "Publisher",
      "item": [
        {
          "name": "Get My Games",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/publisher/games", "host": ["{{baseUrl}}"], "path": ["api","publisher","games"] }
          }
        },
        {
          "name": "Create Game",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "pm.test('Has id and title', () => {",
                  "  pm.expect(json.id).to.exist;",
                  "  pm.expect(json.title).to.eql('Space Rangers');",
                  "});",
                  "if (json.id) { pm.collectionVariables.set('gameId', json.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Space Rangers\",\n  \"description\": \"An epic space adventure game.\",\n  \"price\": 19.99,\n  \"rawgApiId\": \"space-rangers-2002\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/publisher/games", "host": ["{{baseUrl}}"], "path": ["api","publisher","games"] }
          }
        },
        {
          "name": "Update Game",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Title updated', () => pm.expect(pm.response.json().title).to.eql('Space Rangers Remastered'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Space Rangers Remastered\",\n  \"description\": \"An epic space adventure game – now remastered.\",\n  \"price\": 24.99\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/publisher/games/{{gameId}}", "host": ["{{baseUrl}}"], "path": ["api","publisher","games","{{gameId}}"] }
          }
        },
        {
          "name": "Upload Game File (IMAGE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file",     "type": "file",  "src": "" },
                { "key": "fileType", "type": "text",  "value": "IMAGE" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/publisher/games/{{gameId}}/files", "host": ["{{baseUrl}}"], "path": ["api","publisher","games","{{gameId}}","files"] }
          }
        }
      ]
    },
    {
      "name": "Orders (Buyer)",
      "item": [
        {
          "name": "Get My Orders",
          "event": [
            {
