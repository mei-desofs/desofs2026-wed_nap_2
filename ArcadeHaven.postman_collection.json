              "mode": "raw",
              "raw": "{\n  \"title\": \"Space Rangers\",\n  \"description\": \"An epic space adventure game.\",\n  \"price\": 19.99,\n  \"rawgApiId\": \"space-rangers-2002\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/publisher/games", "host": ["{{baseUrl}}"], "path": ["api","publisher","games"] }
          }
        },
        {
          "name": "Create Game – Missing Required Fields (Expects 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Missing fields returns 400', () => pm.response.to.have.status(400));",
                  "pm.test('Validation errors returned', () => pm.expect(pm.response.json().errors).to.exist);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Missing title and price\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/publisher/games", "host": ["{{baseUrl}}"], "path": ["api","publisher","games"] }
          }
        },
        {
          "name": "Update Game",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Title updated', () => pm.expect(pm.response.json().title).to.eql('Space Rangers Remastered'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Space Rangers Remastered\",\n  \"description\": \"An epic space adventure game – now remastered.\",\n  \"price\": 24.99\n}"
            },
