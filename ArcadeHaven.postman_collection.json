{
  "info": {
    "name": "ArcadeHaven API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl",     "value": "http://localhost:8080", "type": "string" },
    { "key": "keycloakUrl", "value": "http://localhost:8180", "type": "string" },
    { "key": "realm",       "value": "arcadehaven",           "type": "string" },
    { "key": "token",       "value": "",                      "type": "string" },
    { "key": "gameId",      "value": "",                      "type": "string" },
    { "key": "orderId",     "value": "",                      "type": "string" },
    { "key": "userId",      "value": "",                      "type": "string" },
    { "key": "entryId",     "value": "",                      "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register – Buyer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Returns username and role', () => {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.username).to.eql('buyer1');",
                  "  pm.expect(json.role).to.eql('BUYER');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"buyer1\",\n  \"email\": \"buyer1@arcadehaven.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"BUYER\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] }
          }
        },
        {
          "name": "Register – Publisher",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Returns username and role', () => {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.username).to.eql('publisher1');",
                  "  pm.expect(json.role).to.eql('PUBLISHER');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
