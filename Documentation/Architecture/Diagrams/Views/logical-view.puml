@startuml
title ArcadeHaven - Logical View (Minimal)

skinparam backgroundColor #f4f4f4
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultTextAlignment center

actor "User" as USER
actor "Publisher" as PUBLISHER
actor "Administrator" as ADMIN

package "ArcadeHaven API (Logical)" {
  rectangle "Authentication\n& Authorization" as AUTH
  rectangle "Game Management" as GAME
  rectangle "Order Management" as ORDER
  rectangle "Library Management" as LIB
  rectangle "File Operations" as FILES
  rectangle "Security Logging" as LOGGING
}

database "Relational Database" as DB
cloud "RAWG API" as RAWG
folder "File Storage" as STORAGE

USER --> AUTH
PUBLISHER --> AUTH
ADMIN --> AUTH

AUTH --> GAME
AUTH --> ORDER
AUTH --> LIB

GAME --> DB
ORDER --> DB
LIB --> DB

GAME --> STORAGE
ORDER --> STORAGE
LIB --> STORAGE

GAME --> RAWG

AUTH --> LOGGING
GAME --> LOGGING
ORDER --> LOGGING
LIB --> LOGGING
FILES --> LOGGING

note bottom
Purpose:
- Keep logical responsibilities stable even if implementation paths change.
- Use this view as architecture contract for threat modeling and testing mappings.
end note

@enduml
