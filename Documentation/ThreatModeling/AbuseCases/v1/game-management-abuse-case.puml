@startuml
left to right direction
skinparam backgroundColor #E8F4F8
skinparam shadowing false
skinparam packageStyle rectangle
skinparam ArrowColor #1F2A35
skinparam ArrowFontColor #1F2A35
skinparam RectangleBackgroundColor #76B9D9
skinparam RectangleBorderColor #1F2A35
skinparam UsecaseBackgroundColor #89C6E2
skinparam UsecaseBorderColor #1F2A35
skinparam ActorBorderColor #1F2A35
skinparam ActorFontColor #1F2A35

actor Publisher
actor Admin
actor Attacker

rectangle "ArcadeHaven - Game Management Abuse Case" {

  Publisher --> (Submit Game)
  Publisher --> (Update Game)
  (Approve or Reject Game) --> Admin

  (Forced Browse Publisher Routes) --> Attacker
  (Forced Browse Admin Approval Routes) --> Attacker
  (Stored XSS in Game Description) --> Attacker
  (RAWG Payload Pollution) --> Attacker

  (Submit Game) -[hidden]left- Publisher
  (Update Game) -[hidden]left- Publisher
  (Approve or Reject Game) -[hidden]right- Admin
  (Forced Browse Admin Approval Routes) -[hidden]right- Attacker
  (RAWG Payload Pollution) -[hidden]right- Attacker
  Admin -[hidden]up- Attacker

  (Submit Game) ..> (Input Sanitization) : <<include>>
  (Submit Game) ..> (External Payload Validation) : <<include>>

  (Update Game) ..> (Input Sanitization) : <<include>>
  (Update Game) ..> (RBAC Validation) : <<include>>

  (Approve or Reject Game) ..> (RBAC Validation) : <<include>>

  (RBAC Validation) ..> (Forced Browse Publisher Routes) : <<mitigates>>
  (RBAC Validation) ..> (Forced Browse Admin Approval Routes) : <<mitigates>>
  (Input Sanitization) ..> (Stored XSS in Game Description) : <<mitigates>>
  (External Payload Validation) ..> (RAWG Payload Pollution) : <<mitigates>>

  (Forced Browse Publisher Routes) ..> (Submit Game) : <<threatens>>
  (Forced Browse Publisher Routes) ..> (Update Game) : <<threatens>>
  (Forced Browse Admin Approval Routes) ..> (Approve or Reject Game) : <<threatens>>
  (Stored XSS in Game Description) ..> (Submit Game) : <<threatens>>
  (Stored XSS in Game Description) ..> (Update Game) : <<threatens>>
  (RAWG Payload Pollution) ..> (Submit Game) : <<threatens>>
}

@enduml